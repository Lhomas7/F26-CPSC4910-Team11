# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------

# Use true only for local HTTP development.
# Staging and production must use false.
DJANGO_DEBUG=true

# Generate a unique local value with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Never commit or share the generated value.
DJANGO_SECRET_KEY=replace-with-a-unique-local-secret-key

# Comma-separated hostnames without http:// or port numbers.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local React development origins.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local development uses HTTP. Production should use HTTPS and true.
DJANGO_SECURE_SSL_REDIRECT=false

# Leave blank for localhost. Production may use a shared parent domain.
DJANGO_COOKIE_DOMAIN=
DJANGO_SESSION_COOKIE_SAMESITE=Lax

# Production-only proxy and HSTS options.
DJANGO_BEHIND_PROXY=false
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Use "sqlite" for isolated local development or "mysql" for shared AWS RDS.
DB_ENGINE=mysql
DB_NAME=Team11_DB
DB_USER=CPSC4911_admin
DB_PASSWORD=replace-with-team-database-password
DB_HOST=replace-with-rds-hostname
DB_PORT=3306


# -----------------------------------------------------------------------------
# MFA encryption
# -----------------------------------------------------------------------------

# Required. This must remain stable for existing encrypted authenticator secrets.
# Generate a new key only for a new environment:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=replace-with-environment-fernet-key


# -----------------------------------------------------------------------------
# Frontend and password reset
# -----------------------------------------------------------------------------

FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT_SECONDS=3600
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------

# Console delivery prints email bodies and verification codes in the backend
# terminal. No external email provider is required for local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@gooddriver.example


# -----------------------------------------------------------------------------
# SMS
# -----------------------------------------------------------------------------

# Leave these blank to print SMS verification codes in the backend terminal.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# -----------------------------------------------------------------------------
# AWS Secrets Manager
# -----------------------------------------------------------------------------

# Leave blank for local development. Set this in staging/production to the AWS
# secret containing values such as DJANGO_SECRET_KEY, DB_PASSWORD, and
# TOTP_ENCRYPTION_KEY.
AWS_SECRETS_MANAGER_SECRET_ID=
AWS_REGION=us-east-1