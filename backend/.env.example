# Select "mysql" to connect Django to the shared AWS RDS instance.
DB_ENGINE=mysql
DB_NAME=Team11_DB
DB_USER=Team11
DB_PASSWORD=replace-with-your-local-secret
DB_HOST=replace-with-your-host
DB_PORT=3306

# Email delivery (console backend by default — see SPRINT_MFA_README_FINAL.md section 4.1)
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@gooddriver.example

# Twilio SMS (leave blank for the console fallback — see section 4.2)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Required for MFA TOTP — a Fernet key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=