# Select "mysql" for the shared AWS RDS database or "sqlite" for a local database.
DB_ENGINE=mysql
DB_NAME=Team11_DB
DB_USER=Team11
DB_PASSWORD=replace-with-team-database-password
DB_HOST=replace-with-rds-hostname
DB_PORT=3306

# Local development prints email messages and verification codes to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@gooddriver.example

# Leave blank to print SMS verification codes to the backend terminal.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Required. Generate a Fernet key, then share the real value privately.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=replace-with-shared-fernet-key