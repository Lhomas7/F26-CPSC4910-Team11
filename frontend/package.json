{
  "name": "frontend",
  "version": "0.6.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^6.30.6",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "lint:js": "eslint \"src/**/*.{js,jsx}\"",
    "lint:js:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\"",
    "lint:docs": "markdownlint-cli2 \"../*.md\" \"../docs/**/*.md\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "react/no-danger": "error",
      "no-eval": "error",
      "no-implied-eval": "error",
      "no-new-func": "error",
      "no-script-url": "error",
      "no-restricted-properties": [
        "error",
        {
          "property": "innerHTML",
          "message": "Render user text with JSX so React escapes it."
        },
        {
          "property": "outerHTML",
          "message": "Render user text with JSX so React escapes it."
        },
        {
          "property": "insertAdjacentHTML",
          "message": "Render user text with JSX so React escapes it."
        },
        {
          "object": "document",
          "property": "write",
          "message": "document.write parses its argument as HTML."
        },
        {
          "object": "document",
          "property": "writeln",
          "message": "document.writeln parses its argument as HTML."
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "**/*.test.js",
          "**/*.test.jsx"
        ],
        "rules": {
          "no-script-url": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
